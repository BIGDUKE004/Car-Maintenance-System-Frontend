+    def accept_request(self, request_id: UUID, admin_id: UUID | None = None):
+        """Accept a pending request and remember which admin did it.
+
+        If another admin got there first, say who instead of the generic
+        "invalid transition" error."""
+        if admin_id is not None:
+            existing = self.maintenance_request_service.get_request_by_id(request_id)
+            if existing.status != MaintenanceStatus.PENDING and existing.accepted_by_id:
+                other = self.user_repository.find_by_id(existing.accepted_by_id)
+                who = f"{other.first_name} {other.last_name}" if other else "another admin"
+                raise AppException(f"This request was already accepted by {who}.")
+
+        request = self.maintenance_request_service.update_status(
             request_id, MaintenanceStatus.ACCEPTED)
 
+        if admin_id is not None:
+            request.accepted_by_id = admin_id
+            request.accepted_at = datetime.now(timezone.utc)
+            request = self.maintenance_request_service.maintenance_request_repository.update(request)
+
+        return request
+
+    @staticmethod
+    def _person(user) -> dict:
+        return {
+            "id": user.id,
+            "name": f"{user.first_name} {user.last_name}",
+            "email": user.email,
+            "phone": user.phone,
+        }
+
+    def _to_admin_response(self, row) -> AdminMaintenanceRequestResponse:
+        request, car, customer, admin = row
+        return AdminMaintenanceRequestResponse(
+            **request.model_dump(),
+            car=car.model_dump(),
+            customer=self._person(customer),
+            accepted_by=self._person(admin) if admin else None,
+        )
+
+    def list_requests(self, status: MaintenanceStatus | None, limit: int, offset: int):
+        repository = self.maintenance_request_service.maintenance_request_repository
+        return [self._to_admin_response(r) for r in repository.list_for_admin(status, limit, offset)]
+
+    def get_request_detail(self, request_id: UUID):
+        repository = self.maintenance_request_service.maintenance_request_repository
+        row = repository.find_for_admin(request_id)
+        if row is None:
+            raise AppException("Maintenance request not found", status_code=404)
+        return self._to_admin_response(row)
+
 
