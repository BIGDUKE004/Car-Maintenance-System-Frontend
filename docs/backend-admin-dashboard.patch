+def _add_missing_columns():
+    """create_all() only creates missing TABLES, never new columns on existing
+    ones. These idempotent statements upgrade databases created before the
+    admin dashboard existed (PostgreSQL). Fresh databases already have them."""
+    if engine.dialect.name != "postgresql":
+        return
+    statements = [
+        "ALTER TABLE maintenance_requests ADD COLUMN IF NOT EXISTS accepted_by_id UUID REFERENCES users(id)",
+        "ALTER TABLE maintenance_requests ADD COLUMN IF NOT EXISTS accepted_at TIMESTAMPTZ",
+    ]
+    with engine.begin() as connection:
+        for statement in statements:
+            connection.execute(text(statement))
