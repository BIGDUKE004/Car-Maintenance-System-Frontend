+    def _admin_query(self):
+        Admin = aliased(User)
+        return (
+            select(MaintenanceRequest, Car, User, Admin)
+            .join(Car, Car.id == MaintenanceRequest.car_id)
+            .join(User, User.id == Car.customer_id)
+            .join(Admin, Admin.id == MaintenanceRequest.accepted_by_id, isouter=True)
+        )
+
+    def list_for_admin(self, status: MaintenanceStatus | None, limit: int, offset: int):
+        """(request, car, customer, accepting_admin | None) rows, newest first."""
+        statement = self._admin_query()
+        if status is not None:
+            statement = statement.where(MaintenanceRequest.status == status)
+        statement = statement.order_by(MaintenanceRequest.created_at.desc()).offset(offset).limit(limit)
+        return list(self.session.exec(statement).all())
+
+    def find_for_admin(self, maintenance_request_id: UUID):
+        statement = self._admin_query().where(MaintenanceRequest.id == maintenance_request_id)
+        return self.session.exec(statement).first()
+
     def update(self, maintenance_request: MaintenanceRequest) -> MaintenanceRequest:
